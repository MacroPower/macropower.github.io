{
  "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "hugo@0.166.0",
    "nodejs@22",
    "lefthook@latest",
    "gh@latest",
    "jq@latest",
    "yq-go@latest"
  ],
  "shell": {
    "init_hook": [
      "[ ! -f package.json ] || [ -d node_modules ] || npm install --silent",
      "[ ! -d .git ] || lefthook install -f >/dev/null"
    ],
    "scripts": {
      "build":     ["hugo --minify"],
      "serve":     ["hugo server -D --disableFastRender"],
      "typecheck": ["npx tsc -p themes/unity --noEmit", "npx tsc -p themes/unity/tsconfig.test.json --noEmit", "npx tsc -p themes/unity/tsconfig.node.json --noEmit"]
    }
  }
}
