{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@xterm/xterm": ["./assets/unity/third_party/xterm/xterm.d.ts"],
      "@xterm/addon-fit": ["./assets/unity/third_party/xterm/addon-fit.d.ts"],
      "@xterm/addon-web-links": ["./assets/unity/third_party/xterm/addon-web-links.d.ts"]
    }
  },
  "include": ["assets/unity/js/**/*"],
  "exclude": ["**/*.test.ts", "**/testkit.ts"]
}
