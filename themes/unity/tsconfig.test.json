{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // tsconfig.json checks the theme's own .d.ts files. This config adds
    // only the Vitest, Playwright, and @types/node typings, which the theme
    // does not own.
    "skipLibCheck": true
  },
  "exclude": [],
  "include": [
    "assets/unity/js/**/*.test.ts",
    "assets/unity/js/**/testkit.ts",
    "tests/**/*.ts"
  ]
}
