{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Every feed: the home page's, the blog section's, and each taxonomy
       and term's. The home feed covers blog posts only (the mainSections,
       see _partials/unity/blog-section.html), since the CV, sponsors, and other
       utility pages would otherwise surface as phantom entries. Each item
       carries the post's summary, or its whole body when
       params.blog.feedFullContent is set. */}}
{{- $pages := .Pages }}
{{- if .IsHome }}
  {{- $pages = partialCached "unity/blog-posts.html" . }}
{{- else if .IsSection }}
  {{- $pages = .RegularPagesRecursive }}
{{- end }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end }}
{{- /* The channel takes the same title as the page's <title> in
       _partials/unity/head.html, so change the two together. */}}
{{- $title := partial "unity/page-title.html" . }}
{{- if .IsHome }}{{ $title = or site.Title $title }}
{{- else if site.Title }}{{ $title = printf "%s | %s" $title site.Title }}{{ end }}
{{- $author := partialCached "unity/author.html" . }}
{{- $contact := "" }}
{{- with $author.email }}{{ $contact = printf "%s (%s)" . $author.name }}{{ end }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ or (cond .IsHome "" .Description) site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with $contact }}
    <managingEditor>{{ . }}</managingEditor>
    <webMaster>{{ . }}</webMaster>
    {{- end }}
    {{- with site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ partial "unity/page-title.html" . }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $contact }}
      <author>{{ . }}</author>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ cond site.Params.blog.feedFullContent .Content .Summary | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
