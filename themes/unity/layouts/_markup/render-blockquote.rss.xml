{{- /* Feed blockquotes. An alert becomes a plain blockquote that opens
      with its title in bold, because feed readers drop the info bar's
      styles and icon. */ -}}
<blockquote>
{{- if eq .Type "alert" }}
  {{- $title := or .AlertTitle (partial "unity/ui/t" (printf "alert_%s" (lower .AlertType))) (partial "unity/ui/t" "alert_note") }}
  <p><strong>{{ $title }}</strong></p>
{{- end }}
  {{ .Text }}
</blockquote>
{{- /**/ -}}
