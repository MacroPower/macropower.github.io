{
  "name": "hugo-theme-unity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev tooling for the unity Hugo theme: type-checks and lints the TypeScript sources, runs the test suites, and refreshes the vendored xterm.js and pdf.js. Hugo's esbuild does the actual bundling at site build time.",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "biome lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sites": "node scripts/build-sites.ts",
    "test:browser": "playwright test -c tests/browser",
    "gallery": "node scripts/capture-gallery.ts",
    "i18n:types": "node scripts/i18n-types.ts",
    "vendor:xterm": "node scripts/vendor-xterm.ts",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "smol-toml": "^1.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
