{
  "name": "jacobcolvin-com",
  "private": true,
  "description": "Personal Hugo site for jacobcolvin.com. The xterm dependencies mirror the theme's package.hugo.json (Hugo's esbuild resolves them from this root node_modules); the scripts delegate to the theme's own configs.",
  "scripts": {
    "typecheck": "tsc -p themes/ubuntu-unity --noEmit",
    "typecheck:test": "tsc -p themes/ubuntu-unity/tsconfig.test.json --noEmit",
    "test": "vitest run --config themes/ubuntu-unity/vitest.config.ts",
    "test:watch": "vitest --config themes/ubuntu-unity/vitest.config.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
