{
  "name": "jacobcolvin-com",
  "private": true,
  "description": "Personal Hugo site for jacobcolvin.com. Its dev tooling is the unity theme's, which this workspace runs.",
  "workspaces": [
    "themes/unity"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w themes/unity",
    "typecheck:test": "npm run typecheck:test -w themes/unity",
    "typecheck:node": "npm run typecheck:node -w themes/unity",
    "lint": "npm run lint -w themes/unity",
    "test": "npm test -w themes/unity",
    "test:watch": "npm run test:watch -w themes/unity",
    "test:sites": "npm run test:sites -w themes/unity",
    "test:browser": "npm run test:browser -w themes/unity",
    "i18n:types": "npm run i18n:types -w themes/unity"
  }
}
